{
  "name": "careweave",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Careweave guided hospital evidence graph prototype",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "export-data": "node scripts/export-data.js",
    "check": "node scripts/check.js",
    "build": "node scripts/build-worker.js",
    "prepare:pilot": "node scripts/prepare-pilot.js",
    "verify:pilot": "node scripts/verify-pilot.js",
    "test:pilot": "node --test tests/pilot-*.test.js tests/prototype-server.test.js",
    "train": "node scripts/train-model.js",
    "db:generate": "drizzle-kit generate",
    "demo:reset": "node scripts/reset-demo.js"
  },
  "dependencies": {
    "cytoscape": "3.33.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2"
  },
  "engines": {
    "node": ">=24"
  }
}
