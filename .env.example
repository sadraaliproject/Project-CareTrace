# Enables the real OpenAI tool-calling agent. Local SQL and ML work without it.
# Copy to .env and add your key locally. It is picked up on the next request.
# Never put an API key in frontend code or commit a real .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=4173

# Optional Gemini ordering of existing, evidence-linked care actions.
# An empty key keeps the local English and Spanish briefs available.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional ElevenLabs audio of the exact reviewed brief.
# Choose a voice available to your account. Device speech is a separate option.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Hosted staff email allowlist, comma-separated. Set separately in Sites secrets.
# Use your own verified sign-in email; never use a public wildcard.
# The local demo on 127.0.0.1 does not require hosted sign-in.
CAREWEAVE_STAFF_EMAILS=
