{
  "name": "careweave",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Synthetic-data care barrier intelligence and coordination demo",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "export-data": "node scripts/export-data.js",
    "check": "node scripts/check.js",
    "build": "node scripts/build-worker.js",
