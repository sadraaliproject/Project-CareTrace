# Active workspace: optional OpenAI investigations, Gemini briefs and ElevenLabs audio.
# Copy to .env and add keys locally. Never commit a real .env file.
# Restart the local server after changes; hosted secrets are configured separately.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=4173

# Optional evidence-linked care-brief ordering.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional speech for approved tasks. A voice ID is also required.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Archived integration only; the active workspace uses browser sessions.
CAREWEAVE_STAFF_EMAILS=
