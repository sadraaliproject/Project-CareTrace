    "demo:reset": "node scripts/reset-demo.js"
  },
  "dependencies": { "cytoscape": "3.33.1" },
  "devDependencies": { "esbuild": "0.25.12", "drizzle-kit": "0.31.10", "drizzle-orm": "0.45.2" },
  "engines": { "node": ">=24" }
}
